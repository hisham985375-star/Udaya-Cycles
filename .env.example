# UDAYA CYCLES Environment Variables
# Copy this file to .env.local for development
# NEVER commit .env.local or .env.production to git

# ============================================================
# APPLICATION
# ============================================================
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NODE_ENV=development

# ============================================================
# DATABASE
# ============================================================
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/udaya-cycles?retryWrites=true&w=majority

# ============================================================
# AUTHENTICATION (NextAuth.js v5)
# ============================================================
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=CHANGE_THIS_generate_with_openssl_rand_base64_32

# Admin JWT (separate from customer NextAuth)
ADMIN_JWT_SECRET=CHANGE_THIS_generate_with_openssl_rand_base64_32
ADMIN_JWT_EXPIRY=8h

# ============================================================
# CLOUDINARY
# ============================================================
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=your_cloud_name

# ============================================================
# RAZORPAY
# ============================================================
RAZORPAY_KEY_ID=rzp_test_your_key_id
RAZORPAY_KEY_SECRET=your_key_secret
RAZORPAY_WEBHOOK_SECRET=your_webhook_secret
# Public: used in frontend Razorpay SDK only
NEXT_PUBLIC_RAZORPAY_KEY_ID=rzp_test_your_key_id

# ============================================================
# EMAIL (Nodemailer / SMTP)
# ============================================================
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=noreply@udayacycles.com
SMTP_PASS=your_smtp_password
EMAIL_FROM=Udaya Cycles <noreply@udayacycles.com>

# ============================================================
# SMS PROVIDER (pluggable interface)
# Supported: msg91 | twilio | none
# ============================================================
SMS_PROVIDER=none
SMS_API_KEY=your_sms_api_key
SMS_SENDER_ID=UDAYA

# ============================================================
# WHATSAPP PROVIDER (pluggable interface)
# Supported: wati | twilio | meta | none
# ============================================================
WHATSAPP_PROVIDER=none
WHATSAPP_API_KEY=your_whatsapp_api_key
WHATSAPP_PHONE_NUMBER_ID=your_phone_number_id

# ============================================================
# GOOGLE MAPS (store locator)
# ============================================================
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=your_google_maps_api_key

# ============================================================
# INITIAL SUPER ADMIN SEED (first-time setup only)
# Change password immediately after first login
# ============================================================
SEED_ADMIN_USERNAME=superadmin
SEED_ADMIN_PASSWORD=ChangeMe@123!

# ============================================================
# RATE LIMITING (optional - Upstash Redis)
# ============================================================
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# ============================================================
# BULK PRODUCT IMPORT
# ============================================================
# Background removal provider: "remove_bg" | "local" (default: local, free)
BG_REMOVAL_PROVIDER=local

# Required only if BG_REMOVAL_PROVIDER=remove_bg
# Get your key at: https://www.remove.bg/api
REMOVE_BG_API_KEY=

# Maximum PDF file size per upload in MB (default: 200)
MAX_IMPORT_FILE_SIZE_MB=200

# Local temp directory for uploaded PDFs during processing
# Default: ./tmp/imports (relative to project root)
IMPORT_UPLOAD_DIR=
